# Database
DATABASE_URL="postgresql://orcalink:orcalink_pass@localhost:5432/orcalink"

# API
PORT=3333
APP_URL="http://localhost:5173"
# api = expõe rotas públicas | worker = expõe também as rotas /api/tasks/*
SERVICE_ROLE="worker"

# Fila assíncrona (Google Cloud Tasks — ver tasks/24)
GCP_PROJECT_ID="orcalink-dev"
GCP_LOCATION="us-central1"
# URL do Cloud Run worker que recebe as tasks (em dev, a própria API)
WORKER_URL="http://localhost:3333"
# Service account usada pelo Cloud Tasks para assinar o token OIDC (produção)
CLOUD_TASKS_INVOKER_SA=""
# Emulador local — quando definido, o client aponta para ele e o guard aceita o segredo abaixo
CLOUD_TASKS_EMULATOR_HOST="localhost:8123"
CLOUD_TASKS_DEV_SECRET="dev-tasks-secret"

# Firebase
FIREBASE_PROJECT_ID="orcalink-dev"
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

# Resend (email)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# WhatsApp (P1 — não-oficial via QR Code)
WHATSAPP_ENABLED=false
WHATSAPP_CREDENTIALS_ENCRYPTION_KEY=""
WHATSAPP_SEND_THROTTLE_MS=2000
WHATSAPP_CONNECT_TIMEOUT_MS=15000
WHATSAPP_PAIR_TIMEOUT_MS=120000
