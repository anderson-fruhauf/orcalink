generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
}

enum QuotationStatus {
  DRAFT
  OPEN
  CLOSED
}

enum SupplierResponseStatus {
  PENDING
  SUBMITTED
  EXPIRED
}

enum DispatchChannel {
  EMAIL
  WHATSAPP
}

enum WhatsappConnectionState {
  DISCONNECTED
  QR_PENDING
  CONNECTED
  ERROR
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  categories      Category[]
  products        Product[]
  suppliers       Supplier[]
  quotations      Quotation[]
  whatsappSession WhatsappSession?
}

model WhatsappSession {
  id              String                  @id @default(uuid())
  tenantId        String                  @unique
  state           WhatsappConnectionState @default(DISCONNECTED)
  connectedNumber String?
  creds           Json?
  lastConnectedAt DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  authKeys WhatsappAuthKey[]
}

model WhatsappAuthKey {
  id        String   @id @default(uuid())
  tenantId  String
  category  String
  keyId     String
  value     Json
  updatedAt DateTime @updatedAt

  session WhatsappSession @relation(fields: [tenantId], references: [tenantId])

  @@unique([tenantId, category, keyId])
  @@index([tenantId])
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String   @unique
  firebaseUid  String   @unique
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
}

model Category {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  products  Product[]
  suppliers SupplierCategory[]
}

model Product {
  id           String   @id @default(uuid())
  tenantId     String
  categoryId   String
  name         String
  description  String?
  unit         String
  internalCode String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  category       Category        @relation(fields: [categoryId], references: [id])
  quotationItems QuotationItem[]
  proposalItems  ProposalItem[]
}

model Supplier {
  id               String          @id @default(uuid())
  tenantId         String
  name             String
  document         String?
  contactName      String?
  email            String
  phone            String?
  preferredChannel DispatchChannel @default(EMAIL)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  categories SupplierCategory[]
  quotations QuotationSupplier[]
  magicLinks MagicLink[]
  proposals  Proposal[]
}

model SupplierCategory {
  id         String   @id @default(uuid())
  supplierId String
  categoryId String
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([supplierId, categoryId])
}

model Quotation {
  id        String          @id @default(uuid())
  tenantId  String
  title     String
  deadline  DateTime
  status    QuotationStatus @default(DRAFT)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  items      QuotationItem[]
  suppliers  QuotationSupplier[]
  magicLinks MagicLink[]
  proposals  Proposal[]
}

model QuotationItem {
  id          String  @id @default(uuid())
  quotationId String
  productId   String
  quantity    Int
  observation String?

  quotation Quotation @relation(fields: [quotationId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([quotationId, productId])
}

model QuotationSupplier {
  id             String                 @id @default(uuid())
  quotationId    String
  supplierId     String
  channel        DispatchChannel        @default(EMAIL)
  sentAt         DateTime               @default(now())
  whatsappSentAt DateTime?
  whatsappError  String?
  responseStatus SupplierResponseStatus @default(PENDING)

  quotation Quotation @relation(fields: [quotationId], references: [id])
  supplier  Supplier  @relation(fields: [supplierId], references: [id])

  @@unique([quotationId, supplierId])
}

model MagicLink {
  id          String   @id @default(uuid())
  token       String   @unique
  quotationId String
  supplierId  String
  active      Boolean  @default(true)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id])
  supplier  Supplier  @relation(fields: [supplierId], references: [id])
  proposal  Proposal?
}

model Proposal {
  id           String    @id @default(uuid())
  quotationId  String
  supplierId   String
  magicLinkId  String    @unique
  deliveryDays Int?
  paymentTerms String?
  notes        String?
  submittedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  quotation Quotation      @relation(fields: [quotationId], references: [id])
  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  magicLink MagicLink      @relation(fields: [magicLinkId], references: [id])
  items     ProposalItem[]
}

model ProposalItem {
  id          String  @id @default(uuid())
  proposalId  String
  productId   String
  unitPrice   Int
  unavailable Boolean @default(false)

  proposal Proposal @relation(fields: [proposalId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([proposalId, productId])
}
